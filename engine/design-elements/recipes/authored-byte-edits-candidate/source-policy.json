{
  "schema": "authored-byte-edits-text-only/v1",
  "allowedPaths": [
    "CONTRACT.md",
    "DESIGN.md",
    "LICENSE",
    "NOTICES.md",
    "README.md",
    "candidate-manifest.json",
    "check-source.py",
    "examples.mjs",
    "fetch-font.py",
    "font-spec.json",
    "index.mjs",
    "io_paths.py",
    "licenses/Bytefold-code-BSD-2-Clause.txt",
    "licenses/HexFiend-BSD-2-Clause.txt",
    "licenses/IBMPlexMono-OFL.txt",
    "licenses/Native-Canvas-MIT.txt",
    "make-package.py",
    "make-report.py",
    "package-lock.json",
    "package.json",
    "render.mjs",
    "runtime.mjs",
    "source-lock.json",
    "source-policy.json",
    "src/input.mjs",
    "src/kit.mjs",
    "src/model.mjs",
    "src/paint.mjs",
    "test-io.py",
    "test-resources.mjs",
    "test.mjs",
    "verify-model.py",
    "verify-raster.mjs"
  ],
  "excluded": [
    "original screenshots, app branding/chrome, private source snapshots",
    "font binaries and other assets",
    "rendered previews/layouts/reports",
    "private handoffs/audits/checkpoint IDs",
    "node_modules/caches/cold copies"
  ],
  "registryChanged": false,
  "rootMediaAllowlistChanged": false
}
