{
  "schema": "bounded-rich-paragraph-source/v1",
  "allowedPaths": [
    "CONTRACT.md",
    "DESIGN.md",
    "LICENSE",
    "NOTICES.md",
    "README.md",
    "candidate-manifest.json",
    "check-source.py",
    "examples/compositions.cjs",
    "examples/render.cjs",
    "font-lock.json",
    "licenses/HTMLAnything-Apache-2.0.txt",
    "licenses/Inter-OFL.txt",
    "licenses/JetBrainsMono-OFL.txt",
    "licenses/OpenDesign-MIT-declared-terms.txt",
    "package-lock.json",
    "package.json",
    "paragraph.cjs",
    "runtime.cjs",
    "source-policy.json",
    "test-runtime.cjs",
    "test.cjs"
  ],
  "excluded": [
    "source/reference HTML and screenshots",
    "full article adapter/fixtures",
    "font binaries",
    "generated media and layout output",
    "private review/backup evidence",
    "node_modules/cache"
  ],
  "rootMediaAllowlistChanged": false,
  "catalogRegistrationChanged": false
}
