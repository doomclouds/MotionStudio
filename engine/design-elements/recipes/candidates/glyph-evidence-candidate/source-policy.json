{
  "schema": "glyph-evidence-text-only/v1",
  "allowedPaths": [
    "CONTRACT.md",
    "DESIGN.md",
    "LICENSE",
    "NOTICES.md",
    "README.md",
    "candidate-manifest.json",
    "check-source.py",
    "examples/render.mjs",
    "examples/scenes.mjs",
    "fetch-masters.py",
    "index.mjs",
    "instance-spec.json",
    "lib/input.mjs",
    "lib/kit.mjs",
    "licenses/Canvas-MIT.txt",
    "licenses/FontGoggles-AUTHORS.txt",
    "licenses/FontGoggles-Apache-2.0.txt",
    "licenses/fonttools-LICENSE.txt",
    "licenses/fraunces-OFL.txt",
    "licenses/inter-OFL.txt",
    "master-lock.json",
    "outline-lock.json",
    "package-lock.json",
    "package.json",
    "prepare-outlines.py",
    "requirements.txt",
    "resource_io.py",
    "runtime.mjs",
    "source-policy.json",
    "test-prepare-io.py",
    "test-resources.py",
    "test.mjs",
    "verify-ink.mjs",
    "verify-model.mjs",
    "verify-model.py"
  ],
  "excluded": [
    "upstream screenshots/ICC images/application window/private evidence",
    "font binaries and derived OFL outlines",
