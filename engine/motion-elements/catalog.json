{
  "schemaVersion": 1,
  "validationAuthority": "Exported runtime validators; examples are executable inputs, not a second validator.",
  "elements": [
    {
      "id": "motion.transform",
      "version": 1,
      "kind": "motion",
      "status": "experimental",
      "summary": "位移、旋转、尺度与显式枢轴的统一仿射动作",
      "api": "sampleMotion",
      "entry": "lib/index.mjs",
      "example": {
        "type": "motion.transform",
        "version": 1,
        "range": {
          "start": {
            "n": "0",
            "d": "1"
          },
          "end": {
            "n": "2",
            "d": "1"
          }
        },
        "curve": {
          "type": "smoothstep"
        },
        "params": {
          "from": {
            "x": 0,
            "y": 0,
            "scaleX": 1,
            "scaleY": 1,
            "rotation": 0
          },
          "to": {
            "x": 120,
            "y": 0,
            "scaleX": 1.2,
            "scaleY": 1.2,
            "rotation": 0
          },
          "origin": {
            "x": 0,
            "y": 0
          }
        }
      },
      "applicability": [
        "强调位置与尺度关系；旋转单位为弧度"
      ],
      "counterexamples": [
        "不包含透视、skew、任意形变；不要用整体位移冒充角色关节运动"
      ],
      "evidence": {
        "technicalTests": [
          "test/core.test.mjs",
          "test/canvas.test.mjs"
        ],
        "visualDemo": "examples/gallery-scene.mjs",
        "artisticReview": "NOT_RUN",
        "originalProductionTransfer": "NOT_RUN"
      },
      "knowledgeLinks": [],
      "tags": [
        "transform",
        "position",
        "rotation",
        "scale",
        "pivot",
        "位移",
        "旋转",
        "尺度"
      ]
    },
