{
  "type": "object",
  "properties": {
    "schema": {
      "const": "motionstudio.work/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "static",
        "video"
      ]
    },
    "publication": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "released",
            "source-release",
            "not-published"
          ]
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "authorship": {
      "type": "object",
      "properties": {
        "unofficial_recreation": {
          "type": "boolean"
        },
        "original": {
          "type": "object",
          "properties": {
            "author": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "author",
            "title",
            "url"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "unofficial_recreation"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "unofficial_recreation": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "original"
            ]
          }
        }
      ]
    },
    "rights": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "reviewed",
            "reviewed-publication-scope",
            "NOT_REVIEWED"
          ]
        },
        "credits": {
          "type": "string",
          "minLength": 1
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "status",
        "credits",
        "notices",
        "evidence_urls"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
