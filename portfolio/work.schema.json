  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:motionstudio:work:1",
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "static"
          }
        }
      },
      "then": {
        "properties": {
          "render": {
            "not": {
