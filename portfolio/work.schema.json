        "required": [
          "id",
          "kind",
          "kind_basis",
          "mode",
          "license",
          "notice",
          "source_url",
          "sha256",
          "permission"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "fetch"
                }
              }
            },
            "then": {
              "required": [
                "fetch_url",
                "max_bytes"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "bytes"
                    ]
                  },
                  {
                    "required": [
                      "generator"
                    ]
                  },
                  {
                    "required": [
                      "instructions"
                    ]
                  },
                  {
                    "required": [
                      "local_path"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "generate"
                }
              }
            },
            "then": {
              "required": [
                "generator"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "bytes"
                    ]
                  },
                  {
                    "required": [
                      "fetch_url"
                    ]
                  },
                  {
                    "required": [
                      "instructions"
                    ]
                  },
                  {
                    "required": [
                      "local_path"
                    ]
                  },
                  {
                    "required": [
                      "max_bytes"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "provide"
                }
              }
            },
            "then": {
              "required": [
                "local_path",
                "bytes",
                "instructions"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "fetch_url"
                    ]
                  },
                  {
                    "required": [
                      "generator"
                    ]
                  },
                  {
                    "required": [
                      "max_bytes"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "cover": {
      "type": "object",
