              },
              "frame": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "render": {
            "required": [
              "timeline",
              "audio"
            ]
          },
          "acceptance": {
            "required": [
              "listened",
              "av_sync"
            ]
          },
          "cover": {
            "properties": {
              "kind": {
                "const": "rendered-frame"
              },
              "frame": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "candidate"
          }
        }
      },
      "then": {
        "required": [
          "history",
          "verification"
        ],
        "not": {
          "required": [
            "acceptance"
          ]
        },
        "properties": {
          "publication": {
            "properties": {
              "status": {
                "const": "not-published"
              }
            }
          },
          "rights": {
            "properties": {
              "status": {
                "const": "NOT_REVIEWED"
              }
            }
          },
          "cover": {
            "required": [
              "binding"
            ]
          }
        }
      },
      "else": {
        "required": [
          "acceptance"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "verification"
              ]
            },
            {
              "required": [
                "history"
              ]
            }
          ]
        },
        "properties": {
          "publication": {
            "properties": {
              "status": {
