                    "audio"
                  ]
                }
              ]
            }
          },
          "acceptance": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "listened"
                  ]
                },
                {
                  "required": [
                    "av_sync"
                  ]
                }
              ]
            }
          },
          "cover": {
            "properties": {
